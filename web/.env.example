# Data service configuration
# Copy this file to .env.local and update with your values.
#
# The browser never calls the yield-curve data service directly (it sends no
# CORS header). It calls the app's own same-origin proxy path, which a Next.js
# rewrite (next.config.ts) forwards to the real service address.

# Browser-facing base path for data reads (same-origin proxy path).
NEXT_PUBLIC_API_BASE_URL=/curve-data

# Server-side only: the real data service address the proxy forwards to.
# Read by next.config.ts when the dev server starts or the app is built.
CURVE_DATA_SERVICE_URL=http://localhost:10020/curve-data

# The data service needs no authentication, so no auth header or token is set.
